# Configure real values in the linked Vercel project's environment settings.
# Pull Development variables with Vercel CLI into .env.local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
# Use a Google AI Studio FREE, UNBILLED project. No paid-provider fallback.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional server-only token for GitHub's public API:
GITHUB_TOKEN=
# Optional real, unexpired generated report to feature at /example:
SAMPLE_EXHIBIT_ID=
